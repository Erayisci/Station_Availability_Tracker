# Copy to `.env` on the VM and fill in real values. `.env` is git-ignored.
#
# ASTOR API token (leave blank to disable the ASTOR poller; ZES is unaffected).
# NOTE: the old token is in git history — rotate it with the provider.
ASTOR_API_AUTHORIZATION=

# These match the Docker service names; usually no need to change them.
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ES_HOST=http://elasticsearch:9200
